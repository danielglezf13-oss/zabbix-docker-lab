# Timezone used by Zabbix web (PHP)
TZ=America/Mexico_City

# --- PostgreSQL ---
# These three values MUST match in postgres, zabbix-server and zabbix-web.
# They are applied only the first time the postgres volume is created.
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zabbix

# --- Ports on your machine ---
ZABBIX_WEB_PORT=8080
ZABBIX_SERVER_PORT=10051

BACKUP_KEEP=14

# --- Web UI login (Zabbix default, not a Docker env var) ---
# User: Admin
# Password: zabbix
# Change it after the first login in Administration → Users.
